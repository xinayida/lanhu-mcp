# Lanhu MCP Server Configuration
# Copy this file to .env and fill in your values if needed.

# ===== Authentication =====
# Option 1 (Recommended): The server automatically reads ~/.lanhu/cookie generated by scripts/refresh_cookie.py.
# Option 2: Set raw cookie here (must include session and user_token).
# LANHU_COOKIE=session=...; user_token=...

# ===== Storage & Paths =====
# Target directory for downloaded assets (defaults to ~/Downloads/lanhu_assets)
LANHU_DOWNLOAD_DIR=~/Downloads/lanhu_assets

# ===== Network & Logging =====
# API request timeout in seconds (default: 30)
LANHU_TIMEOUT=30

# Log level: DEBUG / INFO / WARNING / ERROR (default: INFO)
LANHU_LOG_LEVEL=INFO
